# 업비트 Open API 키 (https://upbit.com/mypage/open_api_management)
# 실거래(live) 모드에서만 필요. 백테스트/모의(paper)는 없어도 됨.
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# 텔레그램 알림 (선택). BotFather로 봇 생성 후 토큰, chat_id는 @userinfobot 등으로 확인
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 기본값
DEFAULT_TICKER=KRW-BTC
DEFAULT_INTERVAL=day
FEE_RATE=0.0005
SLIPPAGE_RATE=0.0005
